<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "NextRound" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="bg-slate-50 min-h-screen">
    <nav class="border-b border-slate-200 bg-white">
      <div class="container mx-auto flex items-center justify-between px-5 py-3">
        <%= link_to "NextRound", root_path, class: "text-lg font-semibold text-slate-900" %>
        <% if user_signed_in? %>
          <div class="flex items-center gap-4 text-sm text-slate-600">
            <% if policy(User).index? %>
              <%= link_to "Invites", invites_path, class: "text-indigo-600 hover:underline" %>
            <% end %>
            <% if profile_path_for(current_user) %>
              <%= link_to "My profile", profile_path_for(current_user), class: "text-indigo-600 hover:underline" %>
            <% end %>
            <span><%= current_user.email %></span>
            <%= button_to "Log out", destroy_user_session_path, method: :delete,
                  class: "text-slate-600 hover:text-slate-900 cursor-pointer" %>
          </div>
        <% else %>
          <%= link_to "Log in", new_user_session_path, class: "text-sm text-slate-600 hover:text-slate-900" %>
        <% end %>
      </div>
    </nav>
    <main class="container mx-auto mt-8 px-5">
      <% if notice %>
        <div class="mb-4 rounded-md border border-emerald-300 bg-emerald-50 p-4 text-sm text-emerald-800">
          <%= notice %>
        </div>
      <% end %>
      <% if alert %>
        <div class="mb-4 rounded-md border border-red-300 bg-red-50 p-4 text-sm text-red-800">
          <%= alert %>
        </div>
      <% end %>
      <%= yield %>
    </main>
  </body>
</html>
