<!DOCTYPE html>
<html>
  <head>
    <title><%= content_for(:title) || "NextRound" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>
    <%= yield :head %>
    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">
    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>
  <body class="win-window min-h-screen">
    <div class="win-titlebar px-3 py-2" data-controller="nav">
      <div class="flex items-center justify-between">
        <div class="flex items-center gap-2">
          <%= link_to "NextRound", root_path, class: "font-semibold mr-2" %>
          <div class="hidden md:flex items-center gap-2">
            <%= link_to "Interviews", interviews_path, class: "win-btn" %>
            <% if policy(InterviewTemplate).index? %>
              <%= link_to "Templates", interview_templates_path, class: "win-btn" %>
            <% end %>
            <% if policy(User).index? %>
              <%= link_to "Invites", invites_path, class: "win-btn" %>
            <% end %>
            <% if profile_path_for(current_user) %>
              <%= link_to "My profile", profile_path_for(current_user), class: "win-btn" %>
            <% end %>
          </div>
        </div>
        <div class="hidden md:flex items-center gap-3">
          <span class="text-sm"><%= current_user.email %></span>
          <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "win-btn win-btn-danger" %>
        </div>
        <!-- Hamburger toggle: below md -->
        <button type="button" class="win-icon-btn md:hidden" data-action="nav#toggle" aria-label="Menu">
          <svg xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none"
               stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="4" y1="6" x2="20" y2="6"/>
            <line x1="4" y1="12" x2="20" y2="12"/>
            <line x1="4" y1="18" x2="20" y2="18"/>
          </svg>
        </button>
      </div>
      <!-- Mobile menu: below md, toggled by the hamburger button -->
      <div data-nav-target="menu" class="hidden md:hidden mt-3 flex flex-col items-stretch gap-2">
        <%= link_to "Interviews", interviews_path, class: "win-btn justify-start" %>
        <% if policy(InterviewTemplate).index? %>
          <%= link_to "Templates", interview_templates_path, class: "win-btn justify-start" %>
        <% end %>
        <% if policy(User).index? %>
          <%= link_to "Invites", invites_path, class: "win-btn justify-start" %>
        <% end %>
        <% if profile_path_for(current_user) %>
          <%= link_to "My profile", profile_path_for(current_user), class: "win-btn justify-start" %>
        <% end %>
        <span class="text-sm break-all py-1"><%= current_user.email %></span>
        <%= button_to "Log out", destroy_user_session_path, method: :delete, class: "win-btn win-btn-danger w-full" %>
      </div>
    </div>
    <main class="p-4">
      <div id="flash"><%= render "shared/flash" %></div>
      <%= yield %>
    </main>
  </body>
</html>
