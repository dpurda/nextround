<div class="mx-auto max-w-2xl">
  <div class="flex items-center justify-between">
    <div>
      <h1 class="text-xl font-semibold"><%= @interview.title %></h1>
      <p class="text-sm text-secondary">
        <%= @interview.interview_type.humanize %> ·
        <%= @interview.scheduled_at&.strftime("%b %-d, %Y %H:%M") || "Not scheduled" %>
      </p>
    </div>
    <%= render "status_badge", interview: @interview %>
  </div>

  <div class="mt-6">
    <%= turbo_frame_tag dom_id(@interview) do %>
      <%= render "details_card", interview: @interview %>
    <% end %>
  </div>

  <div class="mt-8">
    <%= turbo_frame_tag :feedback do %>
      <%= render "feedbacks/card", interview: @interview %>
    <% end %>
  </div>
</div>
