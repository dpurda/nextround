<div class="mx-auto max-w-4xl">
  <div class="flex items-center justify-between">
    <h1 class="text-2xl font-semibold text-slate-900">Interviews</h1>
    <% if policy(Interview).new? %>
      <%= link_to "New interview", new_interview_path,
            class: "rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500" %>
    <% end %>
  </div>

  <% if @interviews.empty? %>
    <p class="mt-6 text-sm text-slate-500">No interviews yet.</p>
  <% else %>
    <table class="mt-6 w-full text-left text-sm">
      <thead class="text-slate-500">
        <tr class="border-b border-slate-200">
          <th class="py-2 font-medium">Title</th>
          <th class="py-2 font-medium">Interviewer</th>
          <th class="py-2 font-medium">Candidate</th>
          <th class="py-2 font-medium">Status</th>
          <th class="py-2 font-medium">Scheduled</th>
          <th class="py-2 font-medium"></th>
        </tr>
      </thead>
      <tbody>
        <% @interviews.each do |interview| %>
          <tr class="border-b border-slate-100">
            <td class="py-2 text-slate-900"><%= interview.title %></td>
            <td class="py-2 text-slate-700"><%= user_display_name(interview.interviewer) %></td>
            <td class="py-2 text-slate-700"><%= user_display_name(interview.candidate) %></td>
            <td class="py-2">
              <span class="rounded-full px-2 py-0.5 text-xs font-medium <%= status_badge_class(interview.status) %>">
                <%= interview.status.humanize %>
              </span>
            </td>
            <td class="py-2 text-slate-500"><%= interview.scheduled_at&.strftime("%b %-d, %Y %H:%M") || "—" %></td>
            <td class="py-2 text-right">
              <%= link_to "View", interview_path(interview), class: "text-indigo-600 hover:underline" %>
            </td>
          </tr>
        <% end %>
      </tbody>
    </table>
  <% end %>
</div>
