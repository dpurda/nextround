<div class="mx-auto max-w-6xl">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-xl font-semibold">Interviews</h1>
    <% if policy(Interview).new? %>
      <%= icon_add_button new_interview_path, label: "New interview" %>
    <% end %>
  </div>

  <%= render layout: "shared/search_form", locals: { q: @q, url: interviews_path } do |f| %>
    <div>
      <%= f.label :title_or_interviewer_name_or_interviewer_email_or_candidate_name_or_candidate_email_cont,
            "Search", class: "win-field-label" %>
      <%= f.search_field :title_or_interviewer_name_or_interviewer_email_or_candidate_name_or_candidate_email_cont,
            class: "win-input", placeholder: "Title, interviewer, or candidate" %>
    </div>
    <div>
      <%= f.label :status_eq, "Status", class: "win-field-label" %>
      <%= f.select :status_eq, Interview.statuses.map { |label, value| [label.humanize, value] }, { include_blank: "Any" }, class: "win-input" %>
    </div>
    <div>
      <%= f.label :interview_type_eq, "Type", class: "win-field-label" %>
      <%= f.select :interview_type_eq, Interview.interview_types.map { |label, value| [label.humanize, value] }, { include_blank: "Any" }, class: "win-input" %>
    </div>
    <div>
      <%= f.label :feedback_recommendation_eq, "Recommendation", class: "win-field-label" %>
      <%= f.select :feedback_recommendation_eq, Feedback.recommendations.map { |label, value| [label.humanize, value] }, { include_blank: "Any" }, class: "win-input" %>
    </div>
    <div>
      <%= f.label :scheduled_at_gteq, "From", class: "win-field-label" %>
      <%= f.date_field :scheduled_at_gteq, class: "win-input" %>
    </div>
    <div>
      <%= f.label :scheduled_at_lteq, "To", class: "win-field-label" %>
      <%= f.date_field :scheduled_at_lteq, class: "win-input" %>
    </div>
  <% end %>

  <% if @interviews.empty? %>
    <p class="mt-6 text-sm text-secondary">No interviews found.</p>
  <% else %>
    <div class="mt-6 overflow-x-auto">
      <table class="win-table">
        <thead>
          <tr>
            <th>Title</th>
            <th class="hidden md:table-cell">Interviewer</th>
            <th>Candidate</th>
            <th>Status</th>
            <th class="hidden sm:table-cell">Scheduled</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @interviews.each do |interview| %>
            <tr>
              <td><%= interview.title %></td>
              <td class="hidden md:table-cell"><%= user_display_name(interview.interviewer) %></td>
              <td><%= user_display_name(interview.candidate) %></td>
              <td><%= render "status_badge", interview: interview %></td>
              <td class="hidden sm:table-cell text-secondary"><%= interview.scheduled_at&.strftime("%b %-d, %Y %H:%M") || "—" %></td>
              <td class="text-right">
                <%= link_to "View", interview_path(interview) %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "shared/pagination", pagy: @pagy %>
  <% end %>
</div>
