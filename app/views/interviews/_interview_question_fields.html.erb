<div class="win-panel p-3 mb-3" data-nested-form-row <%= "data-new-record=\"true\"".html_safe if f.object.new_record? %>>
  <%= f.hidden_field :id %>
  <%= f.hidden_field :_destroy %>

  <%= f.labeled_field :prompt, "Question", as: :text_area, rows: 2 %>

  <div class="mt-3 flex items-center gap-2">
    <%= f.check_box :covered %>
    <%= f.label :covered, "Covered", class: "font-semibold text-sm" %>
  </div>

  <div class="mt-3">
    <%= f.labeled_field :notes, "Notes", as: :text_area, rows: 2 %>
  </div>

  <button type="button" class="win-btn win-btn-danger mt-3" data-action="nested-form#remove">Remove</button>
</div>
