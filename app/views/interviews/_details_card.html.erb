<div class="win-panel">
  <div class="win-panel-header flex items-center justify-between px-4 py-3">
    <h2 class="win-detail-label">Details</h2>
    <% if policy(interview).update? %>
      <%= icon_edit_button edit_interview_path(interview), label: "Edit interview" %>
    <% end %>
  </div>

  <dl>
    <div class="win-detail-row">
      <dt class="win-detail-label">Interviewer</dt>
      <dd class="mt-1 text-sm"><%= user_display_name(interview.interviewer) %></dd>
    </div>
    <div class="win-detail-row">
      <dt class="win-detail-label">Candidate</dt>
      <dd class="mt-1 text-sm"><%= user_display_name(interview.candidate) %></dd>
    </div>
    <div class="win-detail-row">
      <dt class="win-detail-label">Duration</dt>
      <dd class="mt-1 text-sm"><%= interview.duration_minutes.presence || "—" %> minutes</dd>
    </div>
  </dl>

  <% if interview.interview_questions.any? %>
    <div class="win-panel-header px-4 py-3">
      <h2 class="win-detail-label">Questions</h2>
    </div>

    <% interview.interview_questions.each do |question| %>
      <div class="win-detail-row">
        <div class="flex items-start justify-between gap-2">
          <p class="text-sm"><%= question.prompt %></p>
          <span class="win-badge <%= question.covered? ? "win-badge-success" : "win-badge-neutral" %>">
            <%= question.covered? ? "Covered" : "Not covered" %>
          </span>
        </div>
        <% if question.notes.present? %>
          <p class="mt-1 text-sm text-secondary"><%= question.notes %></p>
        <% end %>
      </div>
    <% end %>
  <% end %>
</div>
