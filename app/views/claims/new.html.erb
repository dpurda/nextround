<div class="mx-auto mt-16 max-w-sm">
  <h1 class="text-xl font-semibold">Claim your invitation</h1>
  <p class="mt-1 text-sm text-secondary">
    Enter the 16-digit code you were given, choose a password, and you're in.
  </p>

  <% if @user %>
    <%= render "shared/form_errors", object: @user %>
  <% end %>

  <%= form_with url: claim_path, method: :post, html: { class: "mt-6 space-y-4" } do %>
    <div>
      <label class="block font-semibold mb-1 text-sm">Invitation code</label>
      <input type="text" name="invitation_code" value="<%= params[:invitation_code] %>"
             inputmode="numeric" pattern="\d{16}" maxlength="16" required
             class="win-input w-full font-mono tracking-widest">
    </div>

    <div>
      <label class="block font-semibold mb-1 text-sm">Your name</label>
      <input type="text" name="name" value="<%= params[:name] %>" required class="win-input w-full">
    </div>

    <div>
      <label class="block font-semibold mb-1 text-sm">Password</label>
      <input type="password" name="password" required class="win-input w-full">
    </div>

    <div>
      <label class="block font-semibold mb-1 text-sm">Confirm password</label>
      <input type="password" name="password_confirmation" required class="win-input w-full">
    </div>

    <button type="submit" class="win-btn win-btn-primary w-full cursor-pointer">
      Activate account
    </button>
  <% end %>
</div>
