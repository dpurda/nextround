<div class="mx-auto max-w-6xl">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-xl font-semibold">Invites</h1>
    <%= icon_add_button new_invite_path, label: "New invite" %>
  </div>

  <% if @invited_users.empty? %>
    <p class="mt-6 text-sm text-secondary">No invites yet.</p>
  <% else %>
    <div class="mt-6 overflow-x-auto">
      <table class="win-table">
        <thead>
          <tr>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th class="hidden sm:table-cell">Invited</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @invited_users.each do |invited_user| %>
            <tr>
              <td><%= invited_user.email %></td>
              <td><%= invited_user.role.humanize %></td>
              <td>
                <% if invited_user.pending_invitation? %>
                  <span class="win-badge win-badge-warning">Pending</span>
                <% else %>
                  <span class="win-badge win-badge-success">Claimed</span>
                <% end %>
              </td>
              <td class="hidden sm:table-cell text-secondary"><%= invited_user.created_at.to_date.iso8601 %></td>
              <td class="text-right">
                <% if policy(invited_user).show? %>
                  <%= link_to invited_user.pending_invitation? ? "View code" : "View profile", invite_path(invited_user) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>
  <% end %>
</div>
