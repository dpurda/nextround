<div class="mx-auto max-w-6xl">
  <div class="flex flex-wrap items-center justify-between gap-2">
    <h1 class="text-xl font-semibold">Invites</h1>
    <%= icon_add_button new_invite_path, label: "New invite" %>
  </div>

  <%= render layout: "shared/search_form", locals: { q: @q, url: invites_path } do |f| %>
    <div>
      <%= f.label :email_or_name_cont, "Search", class: "win-field-label" %>
      <%= f.search_field :email_or_name_cont, class: "win-input", placeholder: "Name or email" %>
    </div>
    <div>
      <%= f.label :role_eq, "Role", class: "win-field-label" %>
      <%= f.select :role_eq, User.roles.map { |label, value| [label.humanize, value] }, { include_blank: "Any" }, class: "win-input" %>
    </div>
    <div>
      <%= f.label :claimed_at_null, "Status", class: "win-field-label" %>
      <%= f.select :claimed_at_null, [["Pending", "true"], ["Claimed", "false"]], { include_blank: "Any" }, class: "win-input" %>
    </div>
  <% end %>

  <% if @invited_users.empty? %>
    <p class="mt-6 text-sm text-secondary">No invites found.</p>
  <% else %>
    <div class="mt-6 overflow-x-auto">
      <table class="win-table">
        <thead>
          <tr>
            <th>Email</th>
            <th>Role</th>
            <th>Status</th>
            <th class="hidden sm:table-cell">Invited</th>
            <th></th>
          </tr>
        </thead>
        <tbody>
          <% @invited_users.each do |invited_user| %>
            <tr>
              <td><%= invited_user.email %></td>
              <td><%= invited_user.role.humanize %></td>
              <td>
                <% if invited_user.pending_invitation? %>
                  <span class="win-badge win-badge-warning">Pending</span>
                <% else %>
                  <span class="win-badge win-badge-success">Claimed</span>
                <% end %>
              </td>
              <td class="hidden sm:table-cell text-secondary"><%= invited_user.created_at.to_date.iso8601 %></td>
              <td class="text-right">
                <% if policy(invited_user).show? %>
                  <%= link_to invited_user.pending_invitation? ? "View code" : "View profile", invite_path(invited_user) %>
                <% end %>
              </td>
            </tr>
          <% end %>
        </tbody>
      </table>
    </div>

    <%= render "shared/pagination", pagy: @pagy %>
  <% end %>
</div>
