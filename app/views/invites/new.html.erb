<div class="mx-auto max-w-sm">
  <h1 class="text-xl font-semibold">Invite someone</h1>
  <p class="mt-1 text-sm text-secondary">
    They'll get a one-time code to share out of band — no email is sent.
  </p>

  <%= render "shared/form_errors", object: @invited_user %>

  <%= form_with model: @invited_user, url: invites_path, builder: FluentFormBuilder, html: { class: "mt-6 space-y-4" } do |f| %>
    <div>
      <%= f.label :email %>
      <%= f.email_field :email, autofocus: true %>
    </div>

    <div>
      <%= f.label :role %>
      <%= f.select :role, policy(@invited_user).invitable_roles.map { |role| [role.to_s.humanize, role] } %>
    </div>

    <%= f.submit "Create invite", class: "win-btn win-btn-primary w-full cursor-pointer" %>
  <% end %>
</div>
