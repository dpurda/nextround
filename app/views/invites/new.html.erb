<div class="mx-auto max-w-sm">
  <h1 class="text-2xl font-semibold text-slate-900">Invite someone</h1>
  <p class="mt-1 text-sm text-slate-500">
    They'll get a one-time code to share out of band — no email is sent.
  </p>
  <%= render "shared/form_errors", object: @invited_user %>
  <%= form_with model: @invited_user, url: invites_path, html: { class: "mt-6 space-y-4" } do |f| %>
    <div>
      <%= f.label :email, class: "block text-sm font-medium text-slate-700" %>
      <%= f.email_field :email, autofocus: true,
            class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <div>
      <%= f.label :role, class: "block text-sm font-medium text-slate-700" %>
      <%= f.select :role, policy(@invited_user).invitable_roles.map { |role| [role.to_s.humanize, role] },
            {}, class: "mt-1 block w-full rounded-md border-slate-300 shadow-sm focus:border-indigo-500 focus:ring-indigo-500" %>
    </div>
    <%= f.submit "Create invite", class: "w-full rounded-md bg-indigo-600 px-4 py-2 text-sm font-medium text-white hover:bg-indigo-500 cursor-pointer" %>
  <% end %>
</div>
