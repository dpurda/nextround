<div class="mx-auto max-w-lg">
  <% if @invited_user.pending_invitation? %>
    <div class="text-center">
      <h1 class="text-xl font-semibold">Invitation created</h1>
      <p class="mt-1 text-sm text-secondary">
        Share this code with <%= @invited_user.email %> (<%= @invited_user.role.humanize %>).
        It expires in 7 days and can only be used once.
      </p>

      <div class="win-panel mt-6 p-6">
        <span class="font-mono text-3xl tracking-widest"><%= @invited_user.invitation_code %></span>
      </div>
    </div>
  <% else %>
    <div class="flex items-center justify-between">
      <div>
        <h1 class="text-xl font-semibold"><%= @invited_user.name %></h1>
        <p class="text-sm text-secondary"><%= @invited_user.email %> · <%= @invited_user.role.humanize %></p>
      </div>
      <span class="win-badge win-badge-success">Claimed</span>
    </div>

    <div class="mt-6">
      <% if @invited_user.profile.present? %>
        <div class="win-panel">
          <% if @invited_user.candidate? %>
            <%= render "candidate_profiles/cv", candidate_profile: @invited_user.profile %>
          <% else %>
            <%= render "interviewer_profiles/details", interviewer_profile: @invited_user.profile %>
          <% end %>
        </div>
      <% else %>
        <p class="text-sm text-secondary">They haven't completed their profile yet.</p>
      <% end %>
    </div>
  <% end %>

  <div class="mt-6 flex justify-center gap-4 text-sm">
    <%= link_to "Invite someone else", new_invite_path %>
    <%= link_to "Back to invites", invites_path, class: "text-secondary" %>
  </div>
</div>
