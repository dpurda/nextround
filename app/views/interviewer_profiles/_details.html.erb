<dl class="win-panel">
  <% [
       ["Company", interviewer_profile.company],
       ["Title", interviewer_profile.title],
       ["Years of experience", interviewer_profile.years_of_experience],
       ["Areas of expertise", interviewer_profile.expertise],
       ["Bio", interviewer_profile.bio]
     ].each do |label, value| %>
    <div class="win-detail-row">
      <dt class="win-detail-label"><%= label %></dt>
      <dd class="mt-1 whitespace-pre-line text-sm"><%= value.presence || "—" %></dd>
    </div>
  <% end %>
</dl>
