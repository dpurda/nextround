<div class="mx-auto max-w-lg">
  <h1 class="text-xl font-semibold">
    <%= @interviewer_profile.persisted? ? "Edit your profile" : "Complete your interviewer profile" %>
  </h1>
  <p class="mt-1 text-sm text-secondary">
    This helps candidates know who's interviewing them.
  </p>

  <%= render "shared/form_errors", object: @interviewer_profile %>

  <%= form_with model: @interviewer_profile, url: interviewer_profile_path, builder: FluentFormBuilder,
        html: { class: "mt-6 space-y-4" } do |f| %>
    <div class="grid grid-cols-2 gap-4">
      <%= f.labeled_field :company %>
      <%= f.labeled_field :title %>
    </div>

    <%= f.labeled_field :years_of_experience, "Years of experience", as: :number_field %>
    <%= f.labeled_field :expertise, "Areas of expertise", as: :text_area, rows: 2, placeholder: "e.g. Ruby, System Design" %>
    <%= f.labeled_field :bio, as: :text_area, rows: 3 %>

    <%= f.submit "Save profile", class: "win-btn win-btn-primary w-full cursor-pointer" %>
  <% end %>
</div>
