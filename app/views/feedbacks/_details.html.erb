<dl class="divide-y divide-slate-200">
  <% [
       ["Recommendation", feedback.recommendation.humanize],
       ["Overall rating", "#{feedback.overall_rating} / 5"],
       ["Strengths", feedback.strengths],
       ["Improvements", feedback.improvements],
       ["Notes", feedback.notes]
     ].each do |label, value| %>
    <div class="px-4 py-3">
      <dt class="text-xs font-medium uppercase tracking-wide text-slate-500"><%= label %></dt>
      <dd class="mt-1 whitespace-pre-line text-sm text-slate-900"><%= value.presence || "—" %></dd>
    </div>
  <% end %>
</dl>
