<% new_feedback = Feedback.new(interview_id: interview.id) %>
<div class="win-panel">
  <div class="win-panel-header flex items-center justify-between px-4 py-3">
    <h2 class="win-detail-label">Feedback</h2>
    <% if interview.feedback.present? %>
      <% if policy(interview.feedback).update? %>
        <%= icon_edit_button edit_interview_feedback_path(interview), label: "Edit feedback" %>
      <% end %>
    <% elsif policy(new_feedback).create? %>
      <%= icon_add_button new_interview_feedback_path(interview), label: "Add feedback" %>
    <% end %>
  </div>

  <% if interview.feedback.present? %>
    <%= render "feedbacks/details", feedback: interview.feedback %>
  <% else %>
    <p class="px-4 py-3 text-sm text-secondary">No feedback yet.</p>
  <% end %>
</div>
