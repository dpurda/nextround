<%= turbo_frame_tag dom_id(question) do %>
  <div class="win-detail-row">
    <div class="flex items-start justify-between gap-2">
      <p class="text-sm"><%= question.prompt %></p>
      <div class="flex shrink-0 items-center gap-2">
        <span class="win-badge <%= question.covered? ? "win-badge-success" : "win-badge-neutral" %>">
          <%= question.covered? ? "Covered" : "Not covered" %>
        </span>
        <% if policy(question).update? %>
          <%= icon_edit_button edit_interview_interview_question_path(question.interview, question),
                label: current_user.candidate? ? "Answer question" : "Edit question" %>
        <% end %>
      </div>
    </div>

    <% if question.answer.present? %>
      <p class="mt-2 text-sm"><span class="font-semibold">Answer:</span> <%= question.answer %></p>
    <% elsif current_user.candidate? && policy(question).update? %>
      <p class="mt-2 text-sm text-secondary">You haven't answered yet.</p>
    <% end %>

    <% if question.notes.present? %>
      <p class="mt-1 text-sm text-secondary"><%= question.notes %></p>
    <% end %>
  </div>
<% end %>
