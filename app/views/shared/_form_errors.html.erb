<% if object.errors.any? %>
  <div class="win-alert win-alert-error mb-3" data-turbo-temporary>
    <p>
      <%= pluralize(object.errors.count, "error") %> prevented this from being saved:
    </p>
    <ul class="mt-1 list-disc list-inside font-normal">
      <% object.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>
