<dl>
  <% [
       ["Phone", candidate_profile.phone],
       ["Location", candidate_profile.location],
       ["Current role", candidate_profile.current_role],
       ["Target role", candidate_profile.target_role],
       ["Years of experience", candidate_profile.years_of_experience],
       ["Summary", candidate_profile.bio]
     ].each do |label, value| %>
    <div class="win-detail-row">
      <dt class="win-detail-label"><%= label %></dt>
      <dd class="mt-1 whitespace-pre-line text-sm"><%= value.presence || "—" %></dd>
    </div>
  <% end %>

  <div class="win-detail-row">
    <dt class="win-detail-label">Work experience</dt>
    <dd class="mt-2 text-sm">
      <% if candidate_profile.work_experiences.empty? %>
        —
      <% else %>
        <div class="space-y-3">
          <% candidate_profile.work_experiences.each do |work_experience| %>
            <div>
              <p class="font-semibold"><%= work_experience.title %> · <%= work_experience.company %></p>
              <p class="text-xs text-secondary"><%= date_range_for(work_experience.start_date, work_experience.end_date) %></p>
              <% if work_experience.description.present? %>
                <p class="mt-1 whitespace-pre-line"><%= work_experience.description %></p>
              <% end %>
            </div>
          <% end %>
        </div>
      <% end %>
    </dd>
  </div>

  <div class="win-detail-row">
    <dt class="win-detail-label">Education</dt>
    <dd class="mt-2 text-sm">
      <% if candidate_profile.educations.empty? %>
        —
      <% else %>
        <div class="space-y-3">
          <% candidate_profile.educations.each do |education| %>
            <div>
              <p class="font-semibold">
                <%= education.degree %><%= " in #{education.field_of_study}" if education.field_of_study.present? %>
              </p>
              <p class="text-sm"><%= education.institution %></p>
              <p class="text-xs text-secondary"><%= date_range_for(education.start_date, education.end_date) %></p>
            </div>
          <% end %>
        </div>
      <% end %>
    </dd>
  </div>
</dl>
