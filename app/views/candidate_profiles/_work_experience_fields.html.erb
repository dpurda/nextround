<div class="win-panel p-3 mb-3" data-nested-form-row <%= "data-new-record=\"true\"".html_safe if f.object.new_record? %>>
  <%= f.hidden_field :id %>
  <%= f.hidden_field :_destroy %>

  <div class="grid grid-cols-2 gap-3">
    <%= f.labeled_field :company %>
    <%= f.labeled_field :title %>
  </div>

  <div class="mt-3 grid grid-cols-2 gap-3">
    <%= f.labeled_field :start_date, "Start date", as: :date_field %>
    <%= f.labeled_field :end_date, "End date (blank = current)", as: :date_field %>
  </div>

  <div class="mt-3">
    <%= f.labeled_field :description, "Description", as: :text_area, rows: 2 %>
  </div>

  <button type="button" class="win-btn win-btn-danger mt-3" data-action="nested-form#remove">Remove</button>
</div>
